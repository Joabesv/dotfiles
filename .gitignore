# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# ---------------------------------------------------------------------------
# Secrets — never commit these. Defence in depth: install.sh and the README
# both exclude them, and every file that follows is listed here as well.
# ---------------------------------------------------------------------------

# Generated by fish at runtime (universal variables, not configuration).
fish_variables
fish/.config/fish/fish_variables

# Local scratch space for stow conflicts / one-off symlink experiments.
stow-local/

# Local-only sanitized originals. See secrets/README.md.
secrets/*
!secrets/README.md

# OAuth tokens and authenticated sessions
gh/.config/gh/hosts.yml          # GitHub CLI OAuth tokens
github-copilot/apps.json         # Copilot OAuth token (ghu_...)
claude/.credentials.json         # Claude credentials
claude/.claude.json              # Claude account + OAuth state

# Files holding standalone credentials. These are never part of a package;
# the patterns exist so an accidental `git add -A` cannot pick them up.
**/service.json                 # opencode service password
**/redis-servers.toml            # Redis production passwords
**/apps.json                    # OAuth tokens (github-copilot)
axiom-sre/config.toml            # Axiom/Grafana API tokens
squarecloud/config.json          # deploy provider auth_token
zedis/.config/zedis/            # Redis server credentials

# Database connection strings with inline credentials
**/*.env
**/.env
**/.env.*
*.local.*
.env

# Anything else that looks like a credential
*.pem
*.key
*.p12
id_rsa*
**/*credentials*
**/*secret*
