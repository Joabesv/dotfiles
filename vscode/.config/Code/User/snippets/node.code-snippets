  "Fastify startup": {
    "prefix": "node-fastify",
    "body": [
      "import { app } from './app';",
      "",
      "const start = async () => {",
      "\ttry {",
      "\t\tawait app.listen({ port: 5000 });",
      "\t} catch (error) {",
      "\t\tapp.log.error(error);",
      "\t\tprocess.exit(1);",
      "\t}",
      "};",
      "",
      "start();",
      ""
    ],
    "description": "Quick init for an fastify app"
  },
  "Nodejs eslint config": {
    "prefix": "node-eslint-airbnb",
    "body": [
      "{",
      "\"extends\": [\"@rocketseat/eslint-config/node\"],",
      "\"rules\": {",
      "\t\"prettier/prettier\": [",
      "\t\t\"error\",",
      "\t\t{",
      "\t\t\t\"printWidth\": 80,",
      "\t\t\t\"tabWidth\": 2,",
      "\t\t\t\"singleQuote\": true,",
      "\t\t\t\"trailingComma\": \"all\",",
      "\t\t\t\"arrowParens\": \"always\",",
      "\t\t\t\"semi\": true",
      "\t\t}",
      "\t]",
      "}",
      "}"
    ],
    "description": "A quick setup to eslint config"
  },
  "Type-safe env vars": {
    "prefix": "zod-env",
    "body": [
      "import { config as dotEnvConfig } from 'dotenv';",
      "import { z } from 'zod';",
      "",
      "if (process.env.NODE_ENV === 'test') {",
      "\tdotEnvConfig({ path: '.env.test' });",
      "} else {",
      "\tdotEnvConfig();",
      "}",
      "",
      "const envSchema = z.object({",
      "\t// Local machine",
      "\tNODE_ENV: z.enum(['dev', 'test', 'prod']).default('dev'),",
      "\tPORT: z.coerce.number().default(5000),",
      "\tHOST: z.string().min(4).default('localhost'),",
      "});",
      "",
      "const _env = envSchema.safeParse(process.env);",
      "",
      "if (!_env.success) {",
      "\tconsole.error('invalid envs', _env.error.format());",
      "\tthrow new Error('Invalid environments variables');",
      "}",
      "",
      "export const config = _env.data;",
      ""
    ],
    "description": "Quick env setup"
  },
  "Logger Config": {
    "prefix": "pino-config",
    "body": [
      "import { PrettyOptions } from 'pino-pretty';",
      "",
      "const options = {",
      "\tdestination: 1,",
      "\tcolorize: true,",
      "\ttranslateTime: 'HH:MM:ss.l',",
      "\tignore: 'SYS:pid,hostname',",
      "} satisfies PrettyOptions;",
      "",
      "export const prettyLog = {",
      "\ttransport: {",
      "\t\ttarget: 'pino-pretty',",
      "\t\toptions,",
      "\t},",
      "};"
    ],
    "description": "Setup pino with pretty logs"
  },
  "Fastify route": {
    "prefix": "fastify-route",
    "body": [
      "import type { FastifyPluginAsync } from 'fastify';",
      "",
      "const root: FastifyPluginAsync = async (fastify, opts) => {",
      "\t fastify.get('/', async (request, reply) => {",
      "\t\ttry {",
      "\t\t\tfastify.log.info('this is working, root route')",
      "\t\t\treturn reply.code(200).send({ msg: 'be welcome guest' })",
      "\t\t} catch (error: unknown) {",
      "\t\t\tfastify.log.error(error, 'error in root route')",
      "\t\t}",
      "\t})",
      "",
      "};",
      "",
      "export default root;"
    ],
    "description": "Create a simple route with fastify"
  },
  "Fastify Raw route": {
    "prefix": "fastify-raw-route",
    "body": [
      "import type { FastifyPluginAsync } from 'fastify';",
      "",
      "const ${1}: FastifyPluginAsync = async (fastify, opts) => {",
      "\t fastify.get('/', async (request, reply) => {",
      "\t\ttry {",
      "\t\t\tfastify.log.info('')",
      "\t\t\treturn reply.code(200).send()",
      "\t\t} catch (error: unknown) {",
      "\t\t\tfastify.log.error(error, '')",
      "\t\t}",
      "\t})",
      "",
      "};",
      "",
      "export default ${2};"
    ],
    "description": "Create a raw fastify route"
  },
}
