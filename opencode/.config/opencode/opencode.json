{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.railway.com"
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "yaak": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://127.0.0.1:64343/mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    [
      "opencode-postgres",
      {
        "connectionString": "{env:OPENCODE_POSTGRES_URL}",
        "readOnly": true
      }
    ],
    "opencode-exit-plan"
  ],
  "references": {
    "bullmq": "taskforcesh/bullmq",
    "fastify": "fastify/fastify",
    "pgboss": "timgit/pg-boss"
  }
}
